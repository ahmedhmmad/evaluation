        "jsCode": "// خطأ من قاعدة البيانات (مثل مفتاح n8n غير مطابق) يظهر أحمر في سجل التنفيذ\nconst res = $input.first().json;\nif (res.error) throw new Error(res.error);\n// الرد الفارغ: لا يُرسل شيء. سبب ذلك في res.note (رقم غير مسجَّل، أو رسالة خارج محادثة الغياب)\nconst reply = (res.reply || '').trim();\nif (!reply) return [];\nconst src = $('استخراج الرقم والنص').first().json;\nreturn [{ json: { number: src.phone, text: reply, instance: src.instance } }];"
      },
