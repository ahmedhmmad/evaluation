      "parameters": {
        "jsCode": "// رسالة نصية واردة من محادثة فردية فقط (لا الرسائل المرسلة منا ولا المجموعات)\nconst body = $input.first().json.body || $input.first().json;\nconst d = body.data || {};\nconst key = d.key || {};\nif (key.fromMe) return [];\nlet jid = key.remoteJid || '';\nif (jid.endsWith('@g.us') || jid === 'status@broadcast') return [];\n// في بعض الإصدارات يأتي المعرّف بصيغة @lid والرقم الحقيقي في حقل آخر\nif (jid.endsWith('@lid')) jid = key.senderPn || key.remoteJidAlt || d.senderPn || jid;\nconst phone = String(jid).split('@')[0].replace(/[^0-9]/g, '');\nconst m = d.message || {};\nconst text = m.conversation || (m.extendedTextMessage && m.extendedTextMessage.text) || '';\nif (!phone || !text.trim()) return [];\nreturn [{ json: { phone, text: text.trim() } }];"
      },
      "id": "b1a1c0de-0002-4000-8000-000000000002",
      "name": "استخراج الرقم والنص",
