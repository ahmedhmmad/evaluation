    {
      "parameters": {
        "jsCode": "// رسالة نصية واردة من محادثة فردية فقط (لا الرسائل المرسلة منا ولا المجموعات)\nconst body = $input.first().json.body || $input.first().json;\nconst d = body.data || {};\nconst key = d.key || {};\nif (key.fromMe) return [];\nlet jid = key.remoteJid || '';\nif (jid.endsWith('@g.us') || jid === 'status@broadcast') return [];\n// في بعض الإصدارات يأتي المعرّف بصيغة @lid والرقم الحقيقي في حقل آخر\nif (jid.endsWith('@lid')) jid = key.senderPn || key.remoteJidAlt || key.participantAlt || d.senderPn || d.remoteJidAlt || jid;\nif (String(jid).endsWith('@lid')) throw new Error('وصل المرسل بمعرّف @lid دون رقم الجوال: ' + JSON.stringify(key));\nconst phone = String(jid).split('@')[0].replace(/[^0-9]/g, '');\nconst m = d.message || {};\nconst text = m.conversation || (m.extendedTextMessage && m.extendedTextMessage.text) || '';\nif (!phone || !text.trim()) return [];\n// الرد يخرج من الـ instance نفسه الذي استقبل الرسالة\nconst instance = body.instance || 'DarAlaman';\nreturn [{ json: { phone, text: text.trim(), instance } }];"
      },
      "id": "b1a1c0de-0002-4000-8000-000000000002",
      "name": "استخراج الرقم والنص",
      "type": "n8n-nodes-base.code",
