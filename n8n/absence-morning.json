    {
      "parameters": {
        "jsCode": "const base = 'https://ahmedhmmad.github.io/evaluation/absence.html?t=';\nconst rows = $input.all().flatMap(i => Array.isArray(i.json) ? i.json : [i.json]).filter(r => r && r.phone && r.token);\nreturn rows.map(r => ({ json: { number: r.phone, text: `صباح الخير ${r.name}\\n\\nرابط تسجيل غياب اليوم:\\n${base}${r.token}\\n\\nأو أرسل كلمة «غياب» في هذه المحادثة.` } }));"
      },
      "id": "c2b2c0de-0003-4000-8000-000000000003",
      "name": "تجهيز الرسائل",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-760, 100]
    },
    {
